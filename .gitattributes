# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files (ensure LF endings)
*.go text diff=golang
*.mod text
*.sum text
*.md text
*.txt text
*.json text
*.yaml text
*.yml text
*.toml text
*.sh text eol=lf
*.bash text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.sql text
*.html text
*.css text
*.js text
*.ts text

# Binary files (do not modify)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.bmp binary
*.tiff binary
*.tif binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.bz2 binary
*.7z binary
*.rar binary

# Other binary formats
*.pdf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary

# Beads merge driver
.beads/issues.jsonl merge=beads

# Linguist overrides for documentation
docs/** linguist-documentation
*.md linguist-documentation
decisions/** linguist-documentation
AGENTS.md linguist-documentation
README.md linguist-documentation
