{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",
  "default": true,
  "MD013": false,
  "MD040": false,
  "MD033": {
    "allowed_elements": [
      "details",
      "summary",
      "br",
      "sup",
      "sub",
      "kbd",
      "img",
      "a",
      "p",
      "picture",
      "source"
    ]
  },
  "MD041": false,
  "MD024": {
    "siblings_only": true
  },
  "MD007": {
    "indent": 2
  },
  "MD012": {
    "maximum": 2
  },
  "MD026": {
    "punctuation": ".,;:!?"
  },
  "MD029": false,
  "MD036": false,
  "MD030": {
    "ul_single": 1,
    "ol_single": 1,
    "ul_multi": 1,
    "ol_multi": 1
  },
  "MD035": {
    "style": "---"
  },
  "MD046": {
    "style": "fenced"
  },
  "MD048": {
    "style": "backtick"
  },
  "MD049": {
    "style": "underscore"
  },
  "MD050": {
    "style": "asterisk"
  }
}
